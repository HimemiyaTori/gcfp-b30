{
    "name": "gcfp-b30",
    "compatibility_date": "2026-10-06",
    "compatibility_flags": ["nodejs_compat"],
    "main": "worker/index.ts",
    "d1_databases": [
        {
            "database_id": "036d0163-a558-43a3-ba45-31848df82618",
            "binding": "DB",
            "database_name": "gcfp-accounts",
            "migrations_dir": "worker/migrations"
        }
    ],
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
    },
    "vars": {
        "COOKIE_KEY_VERSION": "1",
        "NINTENDO_APP_VERSION": "3.5.0",
        "GCFP_APPLICATION_IDS": "01003f80212d8000",
        "MEDIA_HOSTS": "media-dl.wc.lp1.nega.srv.nintendo.net",
        "MEDIA_DIRECT": "0",
        "NXAPI_CLIENT_ID": "iHSLjtzf3_pYvqNUYFIWZA",
        "EMAIL_DAILY_LIMIT": "90",
        "EMAIL_MONTHLY_LIMIT": "2900"
    },
    "ratelimits": [
        {
            "name": "API_LIMIT",
            "namespace_id": "7891",
            "simple": { "limit": 120, "period": 60 }
        }
    ],
    "previews": {
        "observability": {
            "logs": {
                "enabled": true,
                "head_sampling_rate": 1,
                "invocation_logs": true,
                "persist": true
            },
            "traces": {
                "enabled": false,
                "head_sampling_rate": 1,
                "persist": true
            },
            "issues": {
                "enabled": false
            }
        },
        "vars": {
            "COOKIE_KEY_VERSION": "1",
            "NINTENDO_APP_VERSION": "3.5.0",
            "GCFP_APPLICATION_IDS": "01003f80212d8000",
            "MEDIA_HOSTS": "media-dl.wc.lp1.nega.srv.nintendo.net",
            "MEDIA_DIRECT": "0",
            "NXAPI_CLIENT_ID": "iHSLjtzf3_pYvqNUYFIWZA"
        },
        "ratelimits": [
            {
                "name": "API_LIMIT",
                "namespace_id": "1001",
                "simple": { "limit": 120, "period": 60 }
            }
        ]
    }
}
